import java.io.File
import java.net.HttpURLConnection
import java.net.URL
import java.nio.file.Files
import java.nio.file.StandardCopyOption
import com.fasterxml.jackson.module.kotlin.jacksonObjectMapper
import com.fasterxml.jackson.module.kotlin.readValue

// -----------------------------
// Data Models
// -----------------------------
data class Release(
    val tag_name: String,
    val body: String?,
    val assets: List<Asset>
)

data class Asset(
    val browser_download_url: String,
    val name: String
)

// -----------------------------
// Main Entry
// -----------------------------
fun main() {
    val versionFile = File("app/update")
    val localVersion = readLocalVersion(versionFile)

    println("Current version: $localVersion")

    val release = fetchLatestRelease()
        ?: return println("Unable to retrieve release information.")

    val latestVersion = release.tag_name
    println("Latest version on GitHub: $latestVersion")

    if (!isNewerVersion(latestVersion, localVersion)) {
        println("You are on the latest update ($localVersion)")
        return
    }

    println("New update available: $localVersion → $latestVersion")

    val asset = release.assets.firstOrNull()
        ?: return println("No downloadable assets found in the release.")

    if (downloadAsset(asset)) {
        println("Downloaded asset: ${asset.name}")
        versionFile.writeText(latestVersion)
        println("Updated local version to $latestVersion")
    }

    release.body?.let {
        println("\nRelease Notes:\n$it")
    }
}

// -----------------------------
// Version Handling
// -----------------------------
fun readLocalVersion(file: File): String {
    return if (file.exists()) file.readText().trim() else "0.0.0"
}

fun isNewerVersion(latest: String, current: String): Boolean {
    val latestParts = latest.removePrefix("v").split(".").map { it.toIntOrNull() ?: 0 }
    val currentParts = current.removePrefix("v").split(".").map { it.toIntOrNull() ?: 0 }

    for (i in 0 until maxOf(latestParts.size, currentParts.size)) {
        val l = latestParts.getOrElse(i) { 0 }
        val c = currentParts.getOrElse(i) { 0 }
        if (l > c) return true
        if (l < c) return false
    }
    return false
}

// -----------------------------
// GitHub API
// -----------------------------
fun fetchLatestRelease(): Release? {
    val apiUrl = "https://api.github.com/repos/OuterTune/OuterTune/releases/latest"

    return try {
        val connection = (URL(apiUrl).openConnection() as HttpURLConnection).apply {
            requestMethod = "GET"
            connectTimeout = 5000
            readTimeout = 5000
            setRequestProperty("Accept", "application/vnd.github.v3+json")
        }

        if (connection.responseCode != 200) {
            println("Failed to fetch release info: HTTP ${connection.responseCode}")
            return null
        }

        val response = connection.inputStream.bufferedReader().use { it.readText() }
        jacksonObjectMapper().readValue(response)

    } catch (e: Exception) {
        println("Error fetching release: ${e.message}")
        null
    }
}

// -----------------------------
// Downloading
// -----------------------------
fun downloadAsset(asset: Asset): Boolean {
    return try {
        val connection = (URL(asset.browser_download_url).openConnection() as HttpURLConnection).apply {
            requestMethod = "GET"
            connectTimeout = 5000
            readTimeout = 5000
        }

        connection.inputStream.use { input ->
            Files.copy(input, File(asset.name).toPath(), StandardCopyOption.REPLACE_EXISTING)
        }

        true
    } catch (e: Exception) {
        println("Failed to download asset: ${e.message}")
        false
    }
}
